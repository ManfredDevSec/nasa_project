          }
        },
        {
          "id": "51e81a01-1018-5793-bcfb-1abf431cade8",
          "name": "Submit an eye test (scored or baseline)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/checks/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "checks",
                ""
              ]
            },
            "description": "Saves the test and, in the same step, either updates the astronaut's baseline (`is_baseline: true`, then `assessment` is null and `baseline` is filled) or scores it (`assessment` filled, `baseline` null). `taken_at`, `amsler_*`, `distance_ok`, `notes` are optional. Crew: own astronaut only; Medical Officer: whole crew; Flight surgeon: read-only.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"astronaut\": {{astronaut_id}},\n  \"near_vision_left\": 6,\n  \"near_vision_right\": 8,\n  \"contrast_left\": 5,\n  \"contrast_right\": 6,\n  \"amsler_left\": [\n    [\n      3,\n      4\n    ],\n    [\n      3,\n      5\n    ]\n  ],\n  \"amsler_right\": [],\n  \"headache\": 2,\n  \"eye_pressure\": 1,\n  \"blur\": 2,\n  \"distance_ok\": true,\n  \"notes\": \"\",\n  \"is_baseline\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
