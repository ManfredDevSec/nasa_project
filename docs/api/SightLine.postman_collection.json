  "item": [
    {
      "name": "Health",
      "item": [
        {
          "id": "337c26d3-165f-5f4a-b3e2-7c955091369d",
          "name": "Is the API up?",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "health",
                ""
              ]
            },
            "description": "Checks the database and the cache. 200 when both answer, 503 otherwise. No login needed.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "id": "39cef21f-92a9-51da-8270-c6ca0a734480",
          "name": "Log in (get a token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login",
                ""
              ]
            },
            "description": "Send username + password, get a token. Send it on every other request as `Authorization: Token <token>`. Tokens expire after `AUTH_TOKEN_TTL_HOURS` (default 7 days); logging in again while still valid returns the same token.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the token (and your astronaut) for every other request.",
                  "const body = pm.response.json();",
                  "if (body.token) {",
                  "  pm.collectionVariables.set('token', body.token);",
                  "  if (body.user && body.user.astronaut_id) pm.collectionVariables.set('astronaut_id', body.user.astronaut_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "id": "21480c9c-e663-5cce-b212-0ca8dd66dcb0",
          "name": "Log out",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout",
                ""
              ]
            },
            "description": "Deletes your token, so it stops working on every device."
          }
        },
        {
          "id": "5dbbae39-e4b5-5c14-b6a1-28bd2ee7a218",
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me",
                ""
              ]
            },
            "description": "Who is logged in, their role, and their linked astronaut (null for flight surgeons)."
          }
        },
        {
          "id": "ca9f99d7-7010-5a2e-93a2-4583794b9b90",
          "name": "Update my profile",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me",
                ""
              ]
            },
            "description": "Change your email, first name or last name. Everything else is read-only.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"osei@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "id": "d8b5bf36-73f8-5637-a7b0-112cd0ce4d9a",
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/change/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "change",
                ""
              ]
            },
            "description": "Needs your current password. On success all your old tokens stop working and you get a **new token** in the response. Save it and use it from now on.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"old_password\": \"sightline-demo\",\n  \"new_password\": \"a-much-better-passphrase\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "id": "d4ed7c81-09f4-5548-9ab6-c3c089b0b25e",
          "name": "Forgot password: email a reset link",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/reset/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "reset",
                ""
              ]
            },
            "description": "Always answers 200, even if no account has this email, so nobody can probe which emails exist. The email links to `FRONTEND_URL/reset-password?uid=...&token=...`. The frontend reads `uid` and `token` from the link and calls `password/reset/confirm/`. Locally the email is printed in the backend console instead of being sent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"osei@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "id": "2339ceff-1d48-593a-a988-cddba1c56731",
          "name": "Forgot password: set the new password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/password/reset/confirm/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "password",
                "reset",
                "confirm",
                ""
              ]
            },
            "description": "Send `uid` and `token` from the reset link plus the new password. The link works once and expires after `PASSWORD_RESET_TIMEOUT` (default 1 hour). Old tokens stop working; the user logs in again with the new password.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uid\": \"Mg\",\n  \"token\": \"c9x1k2-5f0e3c1d2b4a6978\",\n  \"new_password\": \"a-much-better-passphrase\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
