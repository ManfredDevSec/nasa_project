        {
          "id": "baa02d90-0235-5793-90dc-03bf414c8e3c",
          "name": "Log today's vitals (create or update)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
