                "astronauts",
                "{{astronaut_id}}",
                "engagement",
                ""
              ],
              "query": [
                {
                  "key": "as_of",
                  "value": "",
                  "disabled": true,
                  "description": "YYYY-MM-DD. Default: today (finished missions: their last day)."
                }
              ]
            },
            "description": "Rules in docs/04 §6. `streak_weeks` counts 7-day windows back from `as_of` with ≥1 scored test."
          }
        },
        {
          "id": "aae23591-ce3b-58b1-b5eb-f731a59cf777",
          "name": "Trends (chart series by mission day)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/astronauts/{{astronaut_id}}/trends/?as_of=&days=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "astronauts",
                "{{astronaut_id}}",
                "trends",
                ""
              ],
              "query": [
                {
                  "key": "as_of",
                  "value": "",
                  "disabled": true,
                  "description": "YYYY-MM-DD. Default: today (finished missions: their last day)."
                },
                {
                  "key": "days",
                  "value": "",
                  "disabled": true,
                  "description": "1–1000, default 90."
                }
              ]
            },
            "description": "The last `days` days (default 90) up to `as_of`: vision (one point per day with a test), cabin CO₂, daily logs and events, all keyed by `mission_day` so the charts line up. Events: `CO2_HIGH_START` (first day above the high mark after a normal day), `CO2_HIGH_END`, `ESCALATED` (RED result)."
          }
        },
        {
          "id": "06cdc14f-fb08-52b7-953b-8b9bf0add088",
          "name": "Crew dashboard (Medical Officer / flight surgeon)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/crew/overview/?as_of=&mission=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "crew",
                "overview",
                ""
              ],
