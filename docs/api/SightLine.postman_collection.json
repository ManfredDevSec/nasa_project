    {
      "name": "Reports",
      "item": [
        {
          "id": "8f3f2177-c705-5d6c-aea4-e4eda0466843",
          "name": "Body map (eyes, heart, sleep, mind)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/astronauts/{{astronaut_id}}/body-map/?as_of=",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "astronauts",
                "{{astronaut_id}}",
                "body-map",
                ""
              ],
              "query": [
                {
                  "key": "as_of",
                  "value": "",
                  "disabled": true,
                  "description": "YYYY-MM-DD. Default: today."
                }
              ]
            },
            "description": "Status + info card per part. EYES = latest eye assessment; HEART = worse of heart rate and blood pressure; SLEEP / MIND from the most recent daily log that has them. No data → `UNKNOWN`. `as_of` (default today) shows the map as it was on that date, using only data up to then."
          }
        },
        {
          "id": "70009ee4-cb8e-5f85-80a5-50fb79c7b264",
          "name": "Engagement (streak, badges, next test)",
          "request": {
            "method": "GET",
