# Copy to .env for local work:  cp .env.example .env
# Never commit .env.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: leave unset locally -> SQLite (backend/db.sqlite3).
# Production (Render) sets this to the Neon connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Cache: leave unset locally -> in-memory cache.
# Docker Compose and Render set this to a Redis URL.
# REDIS_URL=redis://localhost:6379/0

# Auth (defaults shown)
# AUTH_TOKEN_TTL_HOURS=168
# AUTH_THROTTLE_RATE=10/min
# PASSWORD_RESET_TIMEOUT=3600

# Password reset emails link here: FRONTEND_URL/reset-password?uid=...&token=...
FRONTEND_URL=http://localhost:5173

# Email: leave EMAIL_HOST unset -> emails print to the backend console.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=SightLine <no-reply@example.com>

# On Render, RENDER_EXTERNAL_HOSTNAME is set automatically and added to
# DJANGO_ALLOWED_HOSTS + DJANGO_CSRF_TRUSTED_ORIGINS. No need to set it yourself.

# Production only: full origins allowed to POST forms (Django admin login).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com
